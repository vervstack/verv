{{ .GenTag }}

package config
{{if .Imports }}
import ( {{ range $key, $value := .Imports }}
    {{ $value }} "{{ $key }}"{{ end }}
)
{{end}}
// {{ .StructName }} holds parsed configuration values for this section.
type {{ .StructName }} struct { {{ range .Fields }}
    {{ .Key }} {{ .Value }}{{ end }}
}
{{ if .Enums }}{{ range $enumIdx, $enum := .Enums }}
// {{$enum.Name}} enumerates the allowed values for the {{$enum.Name}} field.
const ( {{range $valIdx, $enumVal := $enum.Values }}
    {{$enum.Name}}{{$enumVal.Key}} = {{ $enumVal.Value }}{{ end }}
)
{{ end }}
{{end}}